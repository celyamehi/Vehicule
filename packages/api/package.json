{
  "name": "@lvb/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "start": "node dist/main.js",
    "dev": "concurrently -k -n tsc,api \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --watch-preserve-output dist/main.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1170.0",
    "@aws-sdk/s3-request-presigner": "^3.1170.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@lvb/db": "workspace:*",
    "@lvb/shared": "workspace:*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.10",
    "@nestjs/platform-socket.io": "^11.2.10",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/websockets": "^11.2.10",
    "bullmq": "^5.81.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.44.7",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^9.2.5",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "unplugin-swc": "^1.6.0",
    "vitest": "^3.2.7"
  }
}
