# Copier en .env et adapter. Ne jamais committer .env.
NODE_ENV=development
TZ=Africa/Algiers

# PostgreSQL
POSTGRES_USER=lvb
POSTGRES_PASSWORD=lvb_dev
POSTGRES_DB=lvb
POSTGRES_PORT=5432
DATABASE_URL=postgres://lvb:lvb_dev@localhost:5432/lvb
DATABASE_URL_TEST=postgres://lvb:lvb_dev@localhost:5432/lvb_test

# Redis (BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Stockage S3 (SeaweedFS en dev, voir docker-compose.yml)
S3_PORT=9000
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lvb
S3_ACCESS_KEY=lvb
S3_SECRET_KEY=lvb_dev_secret

# API
API_PORT=4000
JWT_ACCESS_SECRET=a_changer
JWT_REFRESH_SECRET=a_changer_aussi
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# SMS : "console" en dev (le code OTP s'affiche dans les logs de l'API)
SMS_PROVIDER=console

# Règles métier (valeurs par défaut, surchargeables par agence)
BATTEMENT_HEURES_DEFAUT=2
DELAI_CONFIRMATION_AGENCE_MINUTES=120
DELAI_PAIEMENT_MINUTES=15

# Interfaces (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_URL_LOUEUR=http://localhost:3001
